[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503, B008, C901
exclude =
    .git,
    __pycache__,
    .venv,
    .venv-host,
    knowledge_engine/.venv,
    knowledge_engine/.runs,
    knowledge_engine/.lancedb,
    knowledge_engine/.browser_state,
    knowledge_engine/.domain_trust,
    knowledge_engine/.source_archive,
    build,
    dist,
    *.egg-info
per-file-ignores =
    knowledge_engine/scripts/*.py:E402
max-complexity = 18
