# Postgres/pgvector (Phase 0/1 миграции с LanceDB/Qdrant/SQLite) — см. docker-compose.yml.
# POSTGRES_DSN — "сырой" DSN (без +driver): AsyncPostgresSaver работает через psycopg
# (async), PostgresVectorRepository — через asyncpg; оба принимают этот же формат.
# SQLAlchemy-варианты (+psycopg / +asyncpg, напр. для Alembic env.py) выводятся из
# него программно в db/pg_settings.py — не дублировать вручную.
POSTGRES_DSN=postgresql://knowledge_engine:knowledge_engine@localhost:5432/knowledge_engine
POSTGRES_USER=knowledge_engine
POSTGRES_PASSWORD=knowledge_engine
POSTGRES_DB=knowledge_engine
POSTGRES_PORT=5432
VECTOR_EMBED_DIM=1024
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64
VECTOR_HNSW_EF_SEARCH=100
# Phase 2: переключатели бэкенда (см. config.py) — "postgres" дефолт, старые
