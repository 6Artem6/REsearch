# Опциональные оверрайды в промптах тьютора/reasoner (не DAG/RAG Gateway)
KE_PROMPT_CONTEXT_OVERRIDE_LOCAL_MAC=true
KE_PROMPT_CONTEXT_OVERRIDE_FULLSTACK=false
GEMINI_RESPONSE_MAX_SEC=300
GEMINI_RESPONSE_FIRST_TIMEOUT_SEC=120
