PRE_MAP_DEDUP_TOP_K=5
PRE_MAP_DEDUP_TRIAGE_MAX_TPM=250000
PROMPT_TRACE_ALL_LLM=false
PROMPT_TRACE_DIR=logs/session_traces
QDRANT_API_KEY=
QDRANT_CLUSTER_ID=
QDRANT_URL=
RAG_ANCHOR_SUPPLEMENT_MAX=2
RAG_ANCHOR_THRESHOLD=0.70
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_SEARCH_LIMIT=64
RAG_CHUNK_SEMANTIC_DEDUP=0.85
RAG_CHUNK_SIZE=600
