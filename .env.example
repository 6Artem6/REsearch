# Полный каталог переменных: knowledge_engine/docs/ENV_VARIABLES.md
# Чтение env только в knowledge_engine/config.py — в коде импортируйте из config.
# Копируйте в .env при необходимости (docker compose подхватывает автоматически)

SEARXNG_BASE_URL=http://localhost:8080
OLLAMA_BASE_URL=http://localhost:11434

# Exa API (whitelist include_domains) — services/search/exa_client.py, SearchRegistry provider `exa`
# EXA_API_KEY=
# EXA_SEARCH_ENABLED=true
# CURRICULUM_PRACTICAL_EXA_LIMIT=12
# EXA_DOMAIN_CAP_PER_HOST=1
# EXA_FAIR_ROUND_ROBIN_MAX_PER_DOMAIN=1
# EXA_RERANK_LITE_THRESHOLD=5
# EXA_DUAL_QUERY_EN_RATIO=0.7
# EXCLUDED_SOURCES_BLACKLIST=medium.com,dev.to,twitter.com,reddit.com,linkedin.com,youtube.com

# v0.4 hybrid: Gemini + 7B + 1.5B (без passive fallback)
# v0.7 Semantic Scholar | v0.8 Consensus agent (рекомендуется)
GRAPH_VERSION=0.8
# CONSENSUS_MAX_RETRIES=2
# CONSENSUS_START_URL=https://consensus.app/home
# Deep Search может занять 2+ мин — при таймауте увеличьте:
# CONSENSUS_AUTH_RECOVERY_CYCLES=2
# CONSENSUS_REUSE_BROWSER_SESSION=true
# CONSENSUS_CLOSE_AFTER_EACH_HARVEST=true
# CONSENSUS_NEW_DIALOG_MAX_WAIT_SEC=28
# CONSENSUS_UI_POLL_SEC=1.0
# CONSENSUS_PAPER_HARVEST_PASSES=10
# CONSENSUS_USE_QUICK_PAPER_SEARCH=true
# CONSENSUS_QUICK_BASE_URL=https://consensus.app/quick
# CONSENSUS_QUICK_OPEN_ACCESS=true
# CONSENSUS_QUICK_LOAD_MORE_CLICKS=6
# CONSENSUS_QUICK_RESULTS_MAX_WAIT_SEC=45
# CONSENSUS_NEW_THREAD_EACH_RUN=true
# CONSENSUS_BROWSER_HEADLESS=false
# CONSENSUS_BOOTSTRAP_INPUT_TIMEOUT_SEC=45
# Диагностика: python -m knowledge_engine.scripts.check_consensus_playwright --send
# KE_API_RELOAD=true   # uvicorn reload — закрывает Consensus, profile сохраняется
# KE_WORKER_RELOAD_DEBOUNCE_SEC=1.0   # make dev: перезапуск worker при .py
# PLAYWRIGHT_BROWSERS_PATH=  # dev-native.sh выставляет путь в .venv
# Один раз (API остановлен): ./knowledge_engine/scripts/consensus-login.sh
# LIGHT_RAG_MIN_COSINE_SIM=0.42
# LIGHT_RAG_PROFILE_LIMIT=5
# LECTURE_RAG_TOP_K=3
# Lecture dense: пул → Cross-Encoder → MMR (docs/LECTURE_RAG_CONTEXT.md)
# LECTURE_RAG_CANDIDATE_LIMIT=15
# LECTURE_RAG_MMR_TOP_K=5
# LECTURE_RAG_CE_MIN_SCORE=0.38
# LECTURE_RAG_MMR_LAMBDA=0.62
# LECTURE_RAG_RERANK_TIMEOUT_SEC=60
# LECTURE_RAG_KNODE_CANDIDATE_LIMIT=4
# Curriculum: Targeted Node Grounding (default) | legacy Search-First
# CURRICULUM_TARGETED_NODE_GROUNDING_ENABLED=true
# CURRICULUM_SEARCH_FIRST_ENABLED=false
# Search-First (Consensus harvest → Flash DAG): оба false/true и mode=consensus:
#   CURRICULUM_TARGETED_NODE_GROUNDING_ENABLED=false
#   CURRICULUM_SEARCH_FIRST_ENABLED=true
#   python -m knowledge_engine.scripts.run_curriculum_search_first --mode consensus
# CONSENSUS_FORCE_HEADED=true   # default: всегда headed Playwright (не headless)
# CURRICULUM_MODEL_FIRST_MIN_NODES=8
# CURRICULUM_MODEL_FIRST_TARGET_NODES=10
# CURRICULUM_LITE_BATCH_STRICT=true
# CURRICULUM_DEEP_NODE_MAX_HITS=4
# CURRICULUM_DEEP_HYBRID_PRACTICAL_FIRST=true
# CURRICULUM_SEARCH_TARGET_HITS=15
# CURRICULUM_SEARCH_MIN_HITS=8
# CURRICULUM_SEARCH_PROBE_URLS=true
# Режим Consensus только при generation_mode=consensus в UI (не глобальный флаг)
# CURRICULUM_CONSENSUS_PRIMARY=false
# CURRICULUM_USE_V08_CONSENSUS=true  # default true — Playwright fallback
# CURRICULUM_CONSENSUS_MIN_APPROVED_ACADEMIC=2
# CURRICULUM_PRACTICAL_SEARXNG_ENGINES=google,bing
# CURRICULUM_PRACTICAL_SEARXNG_CATEGORIES=general  # в коде всегда ["general"]
# CURRICULUM_ACADEMIC_SEARXNG_LIMIT=8
# CURRICULUM_LITE_SITE_SUGGEST_ENABLED=false
# CURRICULUM_V08_MAX_PAPERS=10
# CURRICULUM_V08_PAPER_POOL_SIZE=75
# EXA_EXCLUDE_TEXT=api reference documentation sdk classes
# EXA_PRACTICAL_HIGHLIGHT_QUERY=...
# node/init lazy grounding (on_demand)
# CURRICULUM_ON_DEMAND_V08_MAX_PAPERS=3
# CURRICULUM_ON_DEMAND_V08_POOL_SIZE=15
# CURRICULUM_ON_DEMAND_ACADEMIC_WAIT_SEC=5
# CURRICULUM_ON_DEMAND_MIN_PRACTICAL_FOR_FAST_RETURN=3
# ACADEMIC_SCIHUB_TIMEOUT_SEC=1.5
# ACADEMIC_FAST_FETCH_TIMEOUT_SEC=8.0
# CURRICULUM_GEMINI_GROUNDING_ENABLED=false
# CURRICULUM_GEMINI_WEB_HARVEST_ENABLED=true
# CURRICULUM_GEMINI_WEB_HARVEST_TIMEOUT_SEC=120
# CURRICULUM_GEMINI_WEB_RESPONSE_MAX_SEC=90
# CURRICULUM_GEMINI_WEB_RESPONSE_FIRST_TIMEOUT_SEC=45
# CURRICULUM_GEMINI_WEB_URL_RETRY_MAX=3
# CURRICULUM_URL_VALIDATE_TIMEOUT_SEC=10
# GOOGLE_CSE_API_KEY=   # опционально (GCP billing)
# GOOGLE_CSE_ID=
# CURRICULUM_GOOGLE_CSE_ENABLED=false
# GOOGLE_CSE_DAILY_LIMIT=100
# SEMANTIC_SCHOLAR_DAILY_LIMIT=100
# CURRICULUM_API_QUOTA_TRACK=true   # .runs/curriculum_api_quota_state.json
# CURRICULUM_PRACTICAL_CSE_LIMIT=8
# CURRICULUM_PRACTICAL_DDGS_LIMIT=5
# CURRICULUM_PRACTICAL_DDGS_ENABLED=false
# CURRICULUM_PRACTICAL_SEARXNG_LIMIT=12
# CURRICULUM_PRACTICAL_SEARXNG_QUERIES=6
# CURRICULUM_LITE_BATCH_EVAL_FALLBACK_N=3
# CURRICULUM_LITE_SITE_SUGGEST_ENABLED=false
# CURRICULUM_PRACTICAL_SNIPPET_MIN_CHARS=300
# CURRICULUM_ACADEMIC_SS_LIMIT=5
# CURRICULUM_ACADEMIC_ARXIV_LIMIT=3
# CURRICULUM_ACADEMIC_ABSTRACT_MIN_CHARS=300
# CURRICULUM_GEMINI_GROUNDING_MAX_URLS=8
# Search / Map grounding (Google Search tool).
# GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# CURRICULUM_GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# CURRICULUM_GEMINI_GROUNDING_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-1.5-flash
# Модуль 3 Directional RAG (cross-encoder, без LLM)
# RAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_CE_TORCH_DTYPE=auto          # auto | float16 | bfloat16 | float32 (MPS → fp16)
# RAG_CE_AUTO_UNLOAD=true          # сброс CE из RAM после idle (worker)
# RAG_CE_AUTO_UNLOAD_IDLE_SEC=300
# RAG_DEFAULT_MIN_RELEVANCE=0.55
# RAG_RETRIEVAL_PER_DIRECTION=5
# RAG_LATENCY_WARN_MS=100
# ==========================================
# LOCAL MODELS (Ollama / VLLM)
# ==========================================
REACT_EVAL_MODEL=qwen2.5-coder:1.5b
LOCAL_L2_MODEL=qwen2.5-coder:7b
LOCAL_HEAVY_MODEL=qwen2.5-coder:7b
LOCAL_ROUTER_MODEL=qwen2.5-coder:1.5b
# Контекст-блоки (галочки) — 1.5B по умолчанию (меньше UMA)
# CONTEXT_EVAL_MODEL=qwen2.5-coder:1.5b
# UMA: KV router 2048 / heavy 4096; keep_alive ускоряет выгрузку весов
# OLLAMA_ROUTER_NUM_CTX=2048
# OLLAMA_HEAVY_NUM_CTX=4096
# OLLAMA_ROUTER_KEEP_ALIVE=2m
# OLLAMA_HEAVY_KEEP_ALIVE=2m
# OLLAMA_HEAVY_KEEP_ALIVE=2m
# OLLAMA_GUARDRAILS_NUM_PREDICT=1536
# OLLAMA_NUM_PREDICT=1024
# OLLAMA_STRUCTURE_NUM_PREDICT=3072
# CONTEXT_EVAL_NUM_PREDICT=2048
# SELECTION_PROMPTS_NUM_PREDICT=256
# SELECTION_PROMPTS_OLLAMA_MODEL=qwen2.5-coder:1.5b
# SELECTION_PROMPTS_TIMEOUT_SEC=3
GUARDRAILS_OLLAMA_MODEL=qwen2.5-coder:7b

# ==========================================
# GEMINI API MODELS (Google AI Studio)
# ==========================================
# GEMINI_API_KEY=your_key_here
# Несколько ключей для ротации при 429 (Search Grounding / curriculum)
# GEMINI_API_KEYS=key1,key2,key3
# Основной Reasoner/Heavy (20 RPD free tier)
GEMINI_REASONER_MODEL=gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Fallback Lite chain (15 RPM / 500 RPD) — tutor, step_analysis, v0.7
GEMINI_LITE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
# Reasoner / curriculum only (5 RPM / 20 RPD)
GEMINI_REASONER_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview

GEMINI_FLASH_MODEL=gemini-3.1-flash-lite
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite
GEMINI_HIGH_QUOTA_MODEL=gemma-4-31b-it

# Google Search grounding (curriculum fast / expand)
GEMINI_GROUNDING_MODEL=gemini-2.5-flash
CURRICULUM_GEMINI_GROUNDING_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-1.5-flash

# ==========================================
# TIMINGS & RETRY POLICY
# ==========================================
GEMINI_RPM_PAUSE_SEC=1.5
GEMINI_RPM_JITTER_SEC=2
GEMINI_RPM_BLOCK_SEC=45
KE_RAG_TIMEOUT_SEC=45
GEMINI_RETRY_BACKOFF_SEC=2,4,8,16
GEMINI_API_TIMEOUT_SEC=120
GEMINI_TUTOR_TIMEOUT_SEC=45
GEMINI_PROBE_BEFORE_USE=false
GEMINI_PROBE_TIMEOUT_SEC=12
# Локальный RPD на каждый успешный запрос (файл .runs/gemini_quota_state.json).
# Разовый probe всех моделей в API — раз в день вручную:
#   python -m knowledge_engine.scripts.check_gemini_quotas --save
GEMINI_QUOTA_TRACK=true

# Domain Trust Engine (v0.5)
DOMAIN_TRUST_ENABLED=true
DOMAIN_TRUST_MIN_SCORE=0.4
DOMAIN_TRUST_BATCH_SIZE=24
DOMAIN_TRUST_HIGH_SCORE=0.75
SOURCE_ARCHIVE_ENABLED=true
# search | cache_first (глобально) — или reuse_cached_sources в POST /analyses
DISCOVERY_MODE=search
SMART_QUERY_SYNTAX_ENABLED=true
SEARXNG_DISCOVERY_CATEGORIES=it,science,general
UNPAYWALL_EMAIL=dev@knowledge-engine.local
# Semantic Scholar — по умолчанию OFF (публичный API часто 429/503)
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_LIMIT=7
# SS API: 1 request/s cumulative (official); интервал между вызовами
# SEMANTIC_SCHOLAR_MIN_INTERVAL_SEC=1.25
# SEMANTIC_SCHOLAR_429_BACKOFF_SEC=1.25
# SEMANTIC_SCHOLAR_ENRICH_TIMEOUT_SEC=2.0
# GRAPH_RECURSION_LIMIT=115  # по умолчанию из MAX_URLS и MAX_RESEARCH_DEPTH
KE_API_HOST=127.0.0.1
KE_API_PORT=8765
# KE_API_RELOAD=true
# REDIS_URL=redis://127.0.0.1:6379/0
# KE_REDIS_LOGS=true
# KE_WORKER_STALE_RUNNING_SEC=300
# KE_NODE_DIVE_TIMEOUT_SEC=900
# SKIP_GEMINI=false
# GEMINI_PRIMARY=true
# MAX_FETCH_URLS=3
# MULTI_SEARCH_SKIP_VISION=true

# В Docker (profile api) compose подставляет:
# SEARXNG_BASE_URL=http://searxng:8080
# OLLAMA_BASE_URL=http://host.docker.internal:11434
