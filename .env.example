# Knowledge Engine — каталог переменных (дефолты из config.py)
# Документация: knowledge_engine/docs/ENV_VARIABLES.md
# Синхронизация: python knowledge_engine/scripts/sync_env_catalog.py --write-example
# Секреты: пустые значения; задайте в .env (не коммитить).

# --- Core / API / graph ---
GRAPH_VERSION=0.4
GRAPH_THREAD_ID=knowledge-engine-session
GRAPH_RECURSION_LIMIT=0
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_ENABLED=true
SEARXNG_TIMEOUT_SEC=15
SEARXNG_DEFAULT_ENGINES=bing,google
SEARXNG_CLIENT_IP=127.0.0.1
SEARXNG_DISCOVERY_CATEGORIES=it,science,general
KE_API_HOST=127.0.0.1
KE_API_PORT=8765
KE_API_BASE=http://127.0.0.1:8765
KE_API_RELOAD=false
KE_NODE_DIVE_TIMEOUT_SEC=3600
KE_NODE_DIVE_ASYNC_TIMEOUT_SEC=600
KE_NODE_DIVE_INIT_ASYNC_TIMEOUT_SEC=3600
KE_NODE_DIVE_INIT_GROUNDING_MIN_TIMEOUT_SEC=3600
KE_INGEST_URL_CONCURRENCY=4
ACADEMIC_INGEST_MAX_BODY_CHARS=80000
GEMMA_BUDGET_MAX_TPM=14400
GEMMA_BUDGET_MAX_RPM=27
GEMMA_BUDGET_OVERFLOW_WAIT_SEC=10

# --- Redis / worker ---
REDIS_URL=
REDIS_SOCKET_TIMEOUT_SEC=120
KE_USE_REDIS=false
KE_REDIS_LOGS=false
KE_TASKS_CHANNEL=ke:tasks
KE_REDIS_LOG_MAX_LINES=20000
KE_WORKER_POLL_SEC=0.4
KE_WORKER_HEARTBEAT_SEC=10
KE_WORKER_STALE_RUNNING_SEC=7200
KE_WORKER_INLINE_FALLBACK=false
KE_WORKER_RELOAD_DEBOUNCE_SEC=1.0
KE_WORKER_STOP_TIMEOUT_SEC=30

# --- Logging / trace ---
KE_TRACE_STDOUT=false
KE_LOG_PLAIN=false
KE_LLM_FULL_TRACE=false
# Markdown-дампы промптов node_deep_dive → logs/session_traces/{session_id}/
ENABLE_PROMPT_TRACE_LOGS=true
PROMPT_TRACE_DIR=logs/session_traces
# true = все Gemini-вызовы (не только node_deep_dive)
PROMPT_TRACE_ALL_LLM=false
# Explicit Gemini context cache (layer1 + system)
ENABLE_GEMINI_EXPLICIT_CACHE=true
GEMINI_CACHE_TTL_SECONDS=3600
GEMINI_CACHE_MIN_EST_TOKENS=32000

# --- Ollama local ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AUTO_START=false
LOCAL_ROUTER_MODEL=qwen2.5-coder:1.5b
LOCAL_HEAVY_MODEL=qwen2.5-coder:7b
LOCAL_L2_MODEL=qwen2.5-coder:7b
REACT_EVAL_MODEL=qwen2.5-coder:1.5b
MAIN_MODEL=qwen2.5-coder:7b
GUARDRAILS_OLLAMA_MODEL=qwen2.5-coder:7b
GUARDRAILS_MODEL=qwen2.5-coder:7b
CONTEXT_EVAL_MODEL=qwen2.5-coder:1.5b
CONTEXT_EVAL_NUM_PREDICT=2048
OLLAMA_ROUTER_NUM_CTX=2048
OLLAMA_HEAVY_NUM_CTX=
OLLAMA_NUM_CTX=4096
OLLAMA_ROUTER_KEEP_ALIVE=5m
OLLAMA_HEAVY_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_NUM_PREDICT=1024
OLLAMA_GUARDRAILS_NUM_PREDICT=1536
OLLAMA_STRUCTURE_NUM_PREDICT=3072
SELECTION_PROMPTS_OLLAMA_MODEL=qwen2.5-coder:1.5b
SELECTION_PROMPTS_TIMEOUT_SEC=60
SELECTION_PROMPTS_KEEP_ALIVE=5m
SELECTION_PROMPTS_NUM_PREDICT=256
ARTICLE_DIAGRAM_FILTER_OLLAMA_MODEL=qwen2.5-coder:7b
ARTICLE_DIAGRAM_FILTER_TIMEOUT_SEC=45
ARTICLE_DIAGRAM_FILTER_NUM_PREDICT=256
ARTICLE_DIAGRAM_FILTER_NUM_CTX=4096
ARTICLE_MAX_DIAGRAMS_PER_ARTICLE=4
COMPETENCY_EXTRACT_OLLAMA_MODEL=qwen2.5-coder:1.5b
COMPETENCY_EXTRACT_TIMEOUT_SEC=45
COMPETENCY_EXTRACT_NUM_PREDICT=320

# --- Blog spatial / triage / Gemma cloud MAP ---
BLOG_SPATIAL_MAP_PROVIDER=gemma_cloud
BLOG_SPATIAL_SUMMARIZER_MODEL=qwen2.5-coder:7b
BLOG_SPATIAL_NUM_CTX=16384
BLOG_SPATIAL_NUM_PREDICT=4096
BLOG_SPATIAL_TIMEOUT_SEC=180
# MAP window / concurrency / output — fixed in knowledge_engine.config (do not diverge):
#   BLOG_SPATIAL_MAP_MAX_TOKENS=2800
#   MAX_CONCURRENT_MAP_REQUESTS=4  (= BLOG_SPATIAL_MAP_CONCURRENCY / GEMMA_CONCURRENCY)
#   GEMMA_MAP_MAX_OUTPUT_TOKENS=4096
BLOG_SPATIAL_MAP_MAX_TOKENS=2800
BLOG_SPATIAL_OVERLAP_TOKENS=400
BLOG_SPATIAL_MAP_CONCURRENCY=4
BLOG_SPATIAL_TRIAGE_ENABLED=true
# true: после подрезки текста triage не удаляет FIG (схемы в картинках) для VLM
BLOG_SPATIAL_TRIAGE_KEEP_FIGURES=true
# MAP не выбрал FIG — VLM по всем FIG из triage/annotate
BLOG_SPATIAL_VLM_FALLBACK_ALL_FIGURES=true
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# Опционально; если пусто — используется GEMINI_API_KEY (или GOOGLE_API_KEY)
GEMMA_API_KEY=
# Основная / дополнительная (failover + чередование в параллельном MAP)
GEMMA_MODEL_NAME=gemma-4-31b-it
GEMMA_PRIMARY_MODEL=gemma-4-31b-it
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it
# Квота Google AI Studio «Gemma 4 (обе модели)» на один ключ — общий пул
GEMMA_QUOTA_SHARED=true
GEMMA_MAX_RPM=30
GEMMA_MAX_TPM=16000
GEMMA_MAX_RPD=14400
# При GEMMA_QUOTA_SHARED=true per-model лимиты ниже игнорируются (дублируют GEMMA_MAX_*)
GEMMA_PRIMARY_MAX_RPM=30
GEMMA_PRIMARY_MAX_TPM=16000
GEMMA_PRIMARY_MAX_RPD=14400
GEMMA_FALLBACK_MAX_RPM=30
GEMMA_FALLBACK_MAX_TPM=16000
GEMMA_FALLBACK_MAX_RPD=14400
# MAP: fixed MAX_CONCURRENT_MAP_REQUESTS=4 for all models (TPM-safe)
GEMMA_CONCURRENCY=4
GEMMA_EST_REQUEST_TOKENS=4000
GEMMA_MAP_MAX_OUTPUT_TOKENS=4096
GEMMA_REDUCE_MAX_OUTPUT_TOKENS=4096
# REDUCE: two_phase (default) = atom dedup → executive synthesis; legacy = single FinalArticleSummary call
REDUCE_STRATEGY=two_phase
CLAIM_DEDUP_MODE=none
CLAIM_MMR_LAMBDA=0.7
SPO_CLUSTER_THRESHOLD=0.85
SPO_RERANKER_DUPLICATE_THRESHOLD=0.88
MAX_CONSENSUS_BATCH_TOKENS=3072
MAX_CONSENSUS_NODES_PER_BATCH=10
MAX_PRIMARY_ANCHORS=3
CODE_PARSER_MODE=linear
CHUNK_ANCHOR_INJECTION=false
ANCHOR_REGEX_VALIDATE=false
USE_GITHUB_TREES_API=false
GITHUB_TOKEN=
MAX_GITHUB_FILE_SIZE_BYTES=102400
GEMMA_EST_OUTPUT_TOKENS=4096
GEMMA_API_TIMEOUT_SEC=120
GEMMA_FALLBACK_MAX_WAIT_SEC=180
# MAP: пакеты по UTC :00, greedy до GEMMA_TARGET_TPM_SAFETY_CAP (15200 при лимите 16k)
GEMMA_MAP_FIXED_MINUTE_PACING=true
GEMMA_TARGET_TPM_SAFETY_CAP=15200
# Два TPM-контура (16k+16k) на один пул MAP-задач; не GEMMA_QUOTA_SHARED для MAP
GEMMA_MAP_FORCE_PER_MODEL_LIMITS=true
GEMMA_FALLBACK_MAX_WAIT_SEC=180
VLM_GEMINI_MODEL=gemini-3.5-flash-lite
# Shared Flash Lite quotas (VLM + tutor + overflow + curriculum) — per model
# Official ≈15 RPM / 250k TPM / 500 RPD → local hard caps:
GEMINI_FLASH_LITE_MAX_RPM=14
GEMINI_FLASH_LITE_MAX_TPM=250000
GEMINI_FLASH_LITE_MAX_RPD=490
# VLM aliases (optional; default = shared Flash Lite caps)
VLM_GEMINI_MAX_RPM=14
VLM_GEMINI_MAX_TPM=250000
VLM_GEMINI_MAX_RPD=490
VLM_GEMINI_CONCURRENCY=3
VLM_GEMINI_EST_INPUT_TOKENS=12000
VLM_GEMINI_EST_OUTPUT_TOKENS=1024

